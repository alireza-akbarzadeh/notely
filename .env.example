# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-secure-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_API_KEY=your_better_auth_dashboard_api_key

# Auth email (default: console — logs reset/verify links in the server terminal)
# When you have a domain, set EMAIL_PROVIDER=resend and verify the domain in Resend.
EMAIL_PROVIDER=console
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=noreply@yourdomain.com

# Social auth — buttons always show; OAuth needs credentials + flag=true
# Google: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_AUTH_GOOGLE=false

# Apple: https://developer.apple.com/account/resources/identifiers/list/serviceId
# Return URL: http://localhost:3000/api/auth/callback/apple
# APPLE_PRIVATE_KEY = full .p8 PEM (PKCS#8). On Vercel use one line with \n:
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
# Leave all APPLE_* empty (or delete them on Vercel) if you are not using Apple Sign In.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# APPLE_APP_BUNDLE_IDENTIFIER=com.notely.app
NEXT_PUBLIC_AUTH_APPLE=false

# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gemini note assistant (optional — leave unset if unused)
# Prefer GOOGLE_GENERATIVE_AI_API_KEY for the Vercel AI SDK Google provider.
# GEMINI_API_KEY is also accepted (e.g. Netlify AI Gateway injection).
# GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=

# Web Push (optional — in-app sound + Notification API still work without these)
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # same value as VAPID_PUBLIC_KEY
# VAPID_SUBJECT=mailto:you@example.com
# Protects POST /api/reminders/dispatch for cron (background push delivery)
# CRON_SECRET=
